# EVORA Environment Variables Template (.env.example)
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the real '.env' file containing secrets to version control.
# =====================================================================

# Cloudinary Zero-Cost Media Storage (Unsigned Upload Preset)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset

# Google Gemini AI API Key (For Eco Buddy civic intelligence)
GEMINI_API_KEY=your_gemini_api_key

# Default Municipality Tenant ID Scope
DEFAULT_TENANT_ID=tenant_dehradun_01

# Firebase Client Configuration (From Firebase Console Project Settings)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
